@model PortalWebnovels.Models.Genero

@{
    ViewData["Title"] = "Excluir gênero";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-0 border-top border-danger border-4">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-danger">⚠️ Confirmação de exclusão</h4>
            </div>
            <div class="card-body p-4 bg-white">
                <div class="alert alert-danger" role="alert">
                    Tem certeza de que deseja excluir o gênero abaixo?
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-3 text-muted">Nome:</dt>
                    <dd class="col-sm-9 fw-bold">@Model.Nome</dd>
                </dl>

                <form asp-action="Excluir" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4">🗑️ Confirmar exclusão</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
