@model PortalWebnovels.Models.ViewModels.GeneroViewModel

@{
    ViewData["Title"] = "Novo gênero";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">➕ Novo gênero</h4>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Criar" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Ex: Fantasia" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Voltar</a>
                        <button type="submit" class="btn btn-success px-4">💾 Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
