@model WebnovelEditarViewModel
@{ ViewData["Title"] = "Editar webnovel"; }

<div class="row justify-content-center"><div class="col-lg-8">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning py-3"><h4 class="mb-0">✏️ Editar webnovel</h4></div>
        <div class="card-body p-4 bg-white">
            <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label fw-semibold"></label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Sinopse" class="form-label fw-semibold"></label>
                    <textarea asp-for="Sinopse" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Sinopse" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <select asp-for="Status" class="form-select">
                        @foreach (StatusObra s in Enum.GetValues(typeof(StatusObra)))
                        {
                            <option value="@((int)s)" selected="@(Model.Status == s)">@s.Descricao()</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Gêneros</label><br />
                    @foreach (var g in Model.GenerosDisponiveis)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="GenerosIds" value="@g.Id" id="g@(g.Id)" checked="@Model.GenerosIds.Contains(g.Id)" />
                            <label class="form-check-label" for="g@(g.Id)">@g.Nome</label>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Detalhes" asp-route-id="@Model.Id" class="btn btn-outline-secondary">&larr; Voltar</a>
                    <button type="submit" class="btn btn-success px-4">💾 Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div></div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
