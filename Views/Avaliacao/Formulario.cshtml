@model AvaliacaoViewModel
@{ ViewData["Title"] = Model.Editando ? "Editar avaliação" : "Avaliar"; }

<div class="row justify-content-center"><div class="col-lg-6">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning py-3"><h4 class="mb-0">⭐ @(Model.Editando ? "Editar avaliação" : "Avaliar") &ndash; @Model.WebnovelTitulo</h4></div>
        <div class="card-body p-4 bg-white">
            <form asp-action="@(Model.Editando ? "Editar" : "Avaliar")" method="post">
                <input type="hidden" asp-for="WebnovelId" />
                <input type="hidden" asp-for="WebnovelTitulo" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Nota" class="form-label fw-semibold"></label>
                    <select asp-for="Nota" class="form-select">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <option value="@i" selected="@(Model.Nota == i)">@(new string('★', i)) (@i)</option>
                        }
                    </select>
                    <span asp-validation-for="Nota" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Texto" class="form-label fw-semibold"></label>
                    <textarea asp-for="Texto" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Texto" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-controller="Webnovel" asp-action="Detalhes" asp-route-id="@Model.WebnovelId" class="btn btn-outline-secondary">&larr; Voltar</a>
                    <button type="submit" class="btn btn-success px-4">💾 Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div></div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
