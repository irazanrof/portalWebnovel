@model IEnumerable<HistoricoItemViewModel>
@{ ViewData["Title"] = "Histórico de leitura"; }

<h2 class="fw-bold mb-3">🕘 Histórico de leitura</h2>
<p class="text-muted">Mostra o último capítulo lido de cada obra.</p>
@if (!Model.Any())
{
    <div class="text-center py-5 bg-white rounded shadow-sm"><p class="text-muted fs-5 mb-0">Você ainda não leu nenhum capítulo.</p></div>
}
else
{
    <div class="card shadow-sm border-0"><div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Obra</th><th>Último capítulo lido</th><th>Quando</th><th></th></tr></thead>
            <tbody>
                @foreach (var h in Model)
                {
                    <tr>
                        <td><a asp-controller="Webnovel" asp-action="Detalhes" asp-route-id="@h.WebnovelId" class="text-decoration-none fw-semibold">@h.WebnovelTitulo</a></td>
                        <td>Cap. @h.CapituloNumero &ndash; @h.CapituloTitulo</td>
                        <td>@h.DataLeitura.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end"><a asp-controller="Capitulo" asp-action="Ler" asp-route-id="@h.CapituloId" class="btn btn-sm btn-primary">▶ Continuar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}
