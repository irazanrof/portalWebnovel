@{
    var usuarioId = Context.Session.GetInt32("UsuarioId");
    var usuarioNome = Context.Session.GetString("UsuarioNome");
    var ehAdmin = Context.Session.GetString("UsuarioTipo") == "Administrador";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal de Webnovels</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold text-warning" asp-controller="Home" asp-action="Index">📖 Portal de Webnovels</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Webnovel" asp-action="Index">Webnovels</a></li>
                        @if (usuarioId != null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Webnovel" asp-action="Index" asp-route-minhas="true">Minhas obras</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Biblioteca" asp-action="Index">Biblioteca</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Favoritos" asp-action="Index">Favoritos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Historico" asp-action="Index">Histórico</a></li>
                        }
                        @if (ehAdmin)
                        {
                            <li class="nav-item"><a class="nav-link text-warning" asp-controller="Admin" asp-action="Index">Administração</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (usuarioId == null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Conta" asp-action="Entrar">Entrar</a></li>
                            <li class="nav-item"><a class="btn btn-warning btn-sm" asp-controller="Conta" asp-action="Cadastrar">Cadastrar</a></li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Conta" asp-action="Perfil">👤 @(usuarioNome + (ehAdmin ? " (admin)" : ""))</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Conta" asp-action="Sair" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Sucesso!</strong> @TempData["Sucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Atenção:</strong> @TempData["Erro"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted py-3 bg-white">
        <div class="container small">
            &copy; 2026 Portal de Webnovels &ndash; FATEC Ribeirão Preto &ndash; Programação Orientada a Objetos
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
