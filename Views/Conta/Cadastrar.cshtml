@model CadastroViewModel
@{ ViewData["Title"] = "Cadastrar"; }

<div class="row justify-content-center"><div class="col-lg-5 col-md-7">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3"><h4 class="mb-0">Criar conta</h4></div>
        <div class="card-body p-4 bg-white">
            <form asp-action="Cadastrar" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label fw-semibold"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Senha" class="form-label fw-semibold"></label>
                    <input asp-for="Senha" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Mínimo de 6 caracteres.</div>
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmarSenha" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-success w-100">Cadastrar</button>
            </form>
            <hr />
            <a asp-action="Entrar">Já tenho conta</a>
        </div>
    </div>
</div></div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
