@model LoginViewModel
@{ ViewData["Title"] = "Entrar"; }

<div class="row justify-content-center"><div class="col-lg-5 col-md-7">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3"><h4 class="mb-0">Entrar</h4></div>
        <div class="card-body p-4 bg-white">
            <form asp-action="Entrar" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" placeholder="ana@email.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Senha" class="form-label fw-semibold"></label>
                    <input asp-for="Senha" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-success w-100">Entrar</button>
            </form>
            <hr />
            <p class="small text-muted mb-1">Contas de teste (senha <code>123456</code>): <code>admin@webnovels.com</code>, <code>ana@email.com</code>, <code>bruno@email.com</code> (diego@email.com está com a publicação revogada).</p>
            <a asp-action="Cadastrar">Ainda não tenho conta</a>
        </div>
    </div>
</div></div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
